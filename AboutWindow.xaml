<Window x:Class="HardMon.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе HardMon"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        MouseLeftButtonDown="OnDrag" KeyDown="OnKeyDown">
    <Border Background="#F0191919" CornerRadius="6" Padding="16,12,16,12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Width="260">
            <TextBlock Text="HardMon" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Foreground="#99FFFFFF" Margin="0,2,0,8"/>
            <TextBlock Foreground="#DDFFFFFF" TextWrapping="Wrap"
                       Text="Плавающий виджет мониторинга железа: ЦП, память, GPU, видеопамять и интернет с разбивкой VPN / напрямую."/>
            <TextBlock Margin="0,10,0,0">
                <Hyperlink x:Name="RepoLink" Foreground="#4FC3F7" Click="OnRepoClick">
                    <Run x:Name="RepoText"/>
                </Hyperlink>
            </TextBlock>
            <Button Content="Закрыть" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="14,3" IsCancel="True" IsDefault="True"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Border>
</Window>
